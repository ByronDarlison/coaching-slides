      "override": {
        "headline": "How are your meetings going?",
        "title": "How are your meetings going?",
        "panels": [
          {
            "role": "Daily",
            "heading": "Daily huddle",
            "support": "7 to 10 minutes, every day except the day of the weekly meeting. The facilitator rotates.",
            "mark": "structure",
            "items": [
              "Good news",
              "Metrics: yesterday’s widget actual and today’s forecast",
              "The #1 thing to get done today",
              "Stucks, and anything that can’t wait"
            ]
          },
          {
            "role": "Weekly",
            "heading": "Weekly 1:1",
            "support": "15 to 30 minutes. Each leader with each direct report, led by the direct report.",
            "mark": "structure",
            "items": [
              "Good news",
              "Metrics",
              "Top 3 priorities for the week",
              "Feedback both ways",
              "Dynamic"
            ]
          },
          {
            "role": "Weekly",
            "heading": "Weekly leadership meeting",
            "support": "60 minutes or less. The CEO owns it.",
            "mark": "structure",
            "items": [
              "Good news",
              "Values recognition",
              "Scoreboard: last week’s widget forecast, actual and this week’s forecast",
              "QHAG status",
              "Priority status",
              "Stucks, asks and offers"
            ]
          }
        ],
        "notes": [
          "Give it about 10 minutes, on the board’s Meeting Rhythm Check-In.",
          "Rate each meeting: 0 below, 1 meets, 2 exceeds expectations.",
          "Quarterly Planning is running too: today is the first one the Kick Off booked.",
          "The Monthly Town Hall starts this quarter. Book it before you leave, with its standing agenda, a year ahead."
        ],
        "support": "For each: running? Working? What to change? Rate it 0, 1 or 2."
      }
